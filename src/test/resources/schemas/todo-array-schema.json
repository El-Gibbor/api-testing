{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TodoArray",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "userId": { "type": "integer" },
      "id": { "type": "integer" },
      "title": { "type": "string" },
      "completed": { "type": "boolean" }
    },
    "required": ["userId", "id", "title", "completed"],
    "additionalProperties": false
  }
}
